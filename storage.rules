// قواعد Firebase Storage — اختيارية (لرفع ملفات الترانيم الصوتية). لا تُنشر تلقائيًا.
// تتطلب تفعيل Storage في مشروع youth-family-c039e (قد يحتاج خطة Blaze حسب سياسة Firebase الحالية).
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /hymns/{hymnId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'servant'
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'servant';
    }
  }
}
